---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import ProjectGrid from "@components/ProjectGrid.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SOCIALS } from "@config";

const RECENT_WRITING_COUNT = 3;

const posts = await getCollection("blog", ({ data }) => !data.draft);
const recentPosts = getSortedPosts(posts).slice(0, RECENT_WRITING_COUNT);

const socialCount = SOCIALS.filter(social => social.active).length;
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>Things I'm building</h1>
      <p>
        AI workflow tooling and developer tools, built under Enginyyr. The
        writing lives on the <a href="/posts/">blog</a>.
      </p>
      {
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    <ProjectGrid />

    <Hr />

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <h2>Recent writing</h2>
          <ul>
            {recentPosts.map(({ data, slug }) => (
              <Card
                href={`/posts/${slug}/`}
                frontmatter={data}
                secHeading={false}
              />
            ))}
          </ul>
          <div class="all-posts-btn-wrapper">
            <LinkButton href="/posts/">
              All posts
              <svg xmlns="http://www.w3.org/2000/svg">
                <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z" />
              </svg>
            </LinkButton>
            <a href="/rss.xml" class="rss-link" title="RSS Feed">
              RSS
            </a>
          </div>
        </section>
      )
    }

    <Footer />
  </main>

  <style>
    #hero {
      @apply pb-6 pt-8;
    }
    #hero h1 {
      @apply my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl;
    }
    #hero p {
      @apply my-2;
    }
    #hero p a {
      @apply text-skin-accent underline decoration-dashed underline-offset-4;
    }
    .social-wrapper {
      @apply mt-4 flex flex-col sm:flex-row sm:items-center;
    }
    .social-links {
      @apply mb-1 mr-2 whitespace-nowrap sm:mb-0;
    }
    #recent-posts {
      @apply pb-6 pt-6;
    }
    #recent-posts h2 {
      @apply text-2xl font-semibold tracking-wide;
    }
    .all-posts-btn-wrapper {
      @apply my-8 flex items-center justify-center gap-6;
    }
    .rss-link {
      @apply text-skin-accent underline decoration-dashed underline-offset-4;
    }
  </style>
</Layout>
